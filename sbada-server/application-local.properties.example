# 이 파일을 application-local.properties 로 복사한 뒤 값을 채운다.
# application-local.properties 는 .gitignore 에 들어 있어 Git(공개 레포)에 올라가지 않는다.

# 1) Google AI Studio(https://aistudio.google.com/apikey)에서 발급한 키 → Gemma 4 를 클라우드로 호출
# sbada.ai.provider=google
# sbada.ai.google.api-key=여기에_키를_붙여넣기

# 2) 또는 내 PC의 Ollama 로 Gemma 실행 (키가 필요 없음)
#    cmd> ollama pull gemma4:e4b
# sbada.ai.provider=ollama
# sbada.ai.ollama.model=gemma4:e4b

# 3) FCM 푸시 (Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키)
# sbada.push.fcm.enabled=true
# sbada.push.fcm.service-account-file=C:/dev/secrets/sbada-firebase-service-account.json

# 4) 카카오맵 (카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > JavaScript 키)
#    콘솔에서 [플랫폼 > Web] 사이트 도메인에 http://localhost 를 등록하고, [카카오맵] 사용 설정을 켠다.
# sbada.map.kakao-js-key=여기에_JavaScript_키

# 5) 카카오 로그인 (카카오 개발자 콘솔 > 내 애플리케이션 > 앱 정보 > 앱 ID — 숫자)
#    콘솔에서 [카카오 로그인] 사용 설정을 켜고, [플랫폼 > Android]에 패키지명 com.sbada.sbada 와 키 해시를 등록한다.
#    앱 쪽 네이티브 앱 키는 sbada_app/android/local.properties 에 kakao.nativeAppKey=... 로 넣는다.
# sbada.auth.kakao.app-id=여기에_앱_ID_숫자
